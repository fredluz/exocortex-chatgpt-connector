{
  "name": "exocortex-chatgpt-connector",
  "version": "0.1.1",
  "description": "MACX Exocortex ChatGPT connector — browser automation for async text and image workflows.",
  "type": "module",
  "bin": {
    "exocortex-chatgpt": "./cli.mjs"
  },
  "files": [
    "*.mjs",
    "selectors.json",
    "README.md",
    "docs/",
    "native/",
    "scripts/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fredluz/exocortex-chatgpt-connector.git"
  },
  "homepage": "https://github.com/fredluz/exocortex-chatgpt-connector",
  "bugs": {
    "url": "https://github.com/fredluz/exocortex-chatgpt-connector/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "chatgpt",
    "mcp",
    "exocortex",
    "macx",
    "multi-agent",
    "playwright",
    "patchright",
    "automation",
    "claude-code"
  ],
  "scripts": {
    "build:native": "scripts/build-native-helper.sh",
    "install:daemon-app": "scripts/install-daemon-app-wrapper.sh",
    "launch": "node cli.mjs launch",
    "daemon": "node cli.mjs daemon",
    "mcp": "node cli.mjs server",
    "http": "node cli.mjs http",
    "check": "node cli.mjs check",
    "test": "node --test 'tests/*.test.mjs'"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "patchright": "^1.59.4"
  }
}
